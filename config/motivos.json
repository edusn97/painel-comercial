const G=['Objetivo atingido','Objetivo perdido','Dúvida','Outro']; const bt=document.body.innerText; let seg=bt.slice(bt.indexOf('Classificação de atendimentos')); let e=seg.search(/atendimentos não classificados|Anúncios|Anuncios/i); if(e>0) seg=seg.slice(0,e); const L=seg.split('\n').map(s=>s.trim()).filter(s=>s.length); const out=[]; let cur=null; for(let k=0;k<L.length;k++){const ln=L[k]; if(G.includes(ln)){cur={nome:ln,cor:({'Objetivo atingido':'verde','Objetivo perdido':'vermelho','Dúvida':'azul','Outro':'cinza'})[ln],total:parseInt((L[k+1]||'').replace(/\D/g,''))||0,itens:[]}; out.push(cur); k++; continue;} if(!cur) continue; if(/%$/.test(ln)) continue; if(/^\d[\d\.]*$/.test(ln)) continue; let cnt=null,kk=k+1; while(kk<L.length){ if(/^\d[\d\.]*$/.test(L[kk])){cnt=parseInt(L[kk].replace(/\D/g,''));break;} if(G.includes(L[kk])) break; kk++;} if(cnt!==null){cur.itens.push({m:ln,n:cnt}); k=kk;} } const nc=(bt.match(/(\d[\d\.]*)\s*\n?\s*atendimentos não classificados/i)||[])[1]; const pi=document.querySelector('input[placeholder="Início"]'), pf=document.querySelector('input[placeholder="Fim"]'); const res={periodo:((pi?pi.value:'').slice(0,5))+' a '+((pf?pf.value:'').slice(0,5)), fonte:'Paper Vines > Relatorios > Resultados (Classificacao de atendimentos)', nao_classificados: nc?parseInt(nc.replace(/\D/g,'')):0, grupos:out}; window.__MOT=JSON.stringify(res,null,2); try{ copy(__MOT); console.log('%cCOPIADO ✓ — cole no motivos.json','color:green;font-weight:bold'); }catch(e){ console.log('%cPRONTO ✓ — agora digite no console:  copy(__MOT)   e dê Enter','color:#b45309;font-weight:bold'); } console.log(__MOT);
